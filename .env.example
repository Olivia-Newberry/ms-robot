# Copy to .env and fill in. .env is git-ignored; never commit the real one.
# Lists are comma-separated. Anything left empty is simply switched off.

# ---- Required ---------------------------------------------------------------
# The bot's token, from the Discord Developer Portal (Bot > Reset Token).
TOKEN=
# Your Discord user ID. Gets the Bot Owner level (/eval, /deploy).
OWNER=

# ---- Optional ---------------------------------------------------------------
# Key for /gif (https://developers.giphy.com). Without it, /gif is unavailable.
GIPHY_API_KEY=
# Set to true only after enabling Message Content under Privileged Gateway Intents,
# or Discord refuses the connection. See README.md.
MESSAGE_CONTENT_INTENT=false

# Bot user IDs whose messages this bot acts on (e.g. a modmail bot that sends
# commands). Other bots are ignored.
ALLOWED_BOTS=

# Bot user IDs that open mod threads with a message containing their own ID. /threaduser
# and !user skip that message to find the member's ID.
MOD_THREAD_SKIP_IDS=

# systemd services on the same server whose memory /stats shows to bot support and up,
# e.g. modmail.service (shown as "Modmail :: 210 MB"). Comma-separated. Leave empty to
# show none. Lines the bot can't read (e.g. in Docker) are left out.
MONITOR_SERVICES=

# ---- One-time import (only for servers set up before 2.0) ----------------------
# The "!verification" hand-off is now set per server in /settings (Verification page).
# If these are set, the next start copies them into that one server's settings (channel
# names are matched to that server's channels) and logs what it did. It happens once;
# after that, /settings is what counts and these lines can be removed. New setups can
# leave them out.
#VERIFICATION_SERVER_ID=
#VERIFICATION_COMMAND=!!verify
#VERIFICATION_HELP_CHANNELS=channel-name,another-channel
#VERIFICATION_HELP_MESSAGE=Please read the sticky message or message our modmail bot
